# ==========================================
# Self-Maintaining APIs (BUMP) Configuration
# Product tagline: "APIs change. Your code adapts."
# ==========================================

# Project
PROJECT_NAME="Self-Maintaining APIs (BUMP)"
API_V1_PREFIX="/api/v1"

# Database (Dedicated local SQLite storage)
# Database file is stored automatically under backend/data/bump.db
DATABASE_URL="sqlite:///backend/data/bump.db"

# LLM Repair Provider: 'mock' (offline rule engine), 'openai', 'anthropic', 'gemini', 'custom'
LLM_PROVIDER="mock"

# OpenAI Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# GitHub App / Personal Access Token Configuration
# When unconfigured, the platform operates transparently in Local Demo Mode
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ACCESS_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# Developer Safety Controls
REQUIRE_DEVELOPER_APPROVAL="true"
ALLOW_AUTO_PR="true"
MAX_TEST_TIMEOUT_SECONDS="45"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
